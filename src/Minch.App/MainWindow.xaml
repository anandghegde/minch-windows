<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Minch.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Minch.App.Views"
    Title="Minch">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Minch"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False"
            PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/minch-512.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    MinWidth="320"
                    MaxWidth="520"
                    PlaceholderText="Search transfers and files"
                    QueryIcon="Find"
                    Visibility="Collapsed"
                    TextChanged="OnSearchTextChanged"
                    QuerySubmitted="OnSearchSubmitted">
                    <AutoSuggestBox.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFocusSearch" />
                    </AutoSuggestBox.KeyboardAccelerators>
                </AutoSuggestBox>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <Button
                    x:Name="PaletteButton"
                    Margin="0,0,8,0"
                    Padding="8,4"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnPaletteClick"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="Command palette (Ctrl+K)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE721;" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Ctrl+K" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <Grid Grid.Row="1">
            <views:OnboardingView x:Name="Onboarding" Visibility="Collapsed" />
            <views:ShellView x:Name="Shell" Visibility="Collapsed" />
            <ProgressRing x:Name="BootRing" Width="40" Height="40" IsActive="True" />
        </Grid>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnPaletteAccelerator" />
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="OnRefreshAccelerator" />
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnAddAccelerator" />
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnOpenTorrentAccelerator" />
        </Grid.KeyboardAccelerators>
    </Grid>
</Window>
