<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Minch.App.Views.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Minch.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" Padding="24,8,24,36" Spacing="4">
            <TextBlock Margin="0,0,0,8" Style="{StaticResource TitleTextBlockStyle}" Text="Account" />

            <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PersonPicture Width="56" Height="56" DisplayName="{x:Bind Account.Email, Mode=OneWay}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Account.Email, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Padding="8,2" CornerRadius="4" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Text="{x:Bind Account.PlanName, Mode=OneWay}" />
                            </Border>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Account.SubscribedText, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" VerticalAlignment="Center" Command="{x:Bind Account.OpenManageCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Manage on torbox.app" />
                            <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <InfoBar IsClosable="False" IsOpen="{x:Bind Account.HasError, Mode=OneWay}" Message="{x:Bind Account.Error, Mode=OneWay}" Severity="Warning">
                <InfoBar.ActionButton>
                    <Button Content="Retry" Command="{x:Bind Account.LoadCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind Account.IsLoading, Mode=OneWay}" />

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Lifetime usage" />
            <Grid ColumnSpacing="4" RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Downloaded" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Account.DownloadedText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Uploaded" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Account.UploadedText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Ratio" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Account.RatioText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Items" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Account.ItemsText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Subscriptions" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="No subscriptions on record." Visibility="{x:Bind NoSubscriptions(Account.HasSubscriptions), Mode=OneWay}" />
            <ItemsRepeater ItemsSource="{x:Bind Account.Subscriptions}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="4" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:SubscriptionRow">
                        <tk:SettingsCard Header="{x:Bind Title}" Description="{x:Bind Detail}">
                            <tk:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8C7;" />
                            </tk:SettingsCard.HeaderIcon>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Status}" />
                        </tk:SettingsCard>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Session" />
            <tk:SettingsCard Header="Sign out" Description="Removes the API key from this PC and clears the local library cache.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xF3B1;" />
                </tk:SettingsCard.HeaderIcon>
                <Button Content="Sign out" Click="OnSignOut" />
            </tk:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
