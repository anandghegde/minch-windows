<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Minch.App.Views.PlayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:Minch.App.Helpers"
    xmlns:vm="using:Minch.ViewModels">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>
    <Grid x:Name="Root" Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="PlayerTitleBar" Title="{x:Bind Vm.Title}" Subtitle="{x:Bind Vm.TransferName}" RequestedTheme="Dark">
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,8,0">
                    <ComboBox
                        MinWidth="120"
                        PlaceholderText="Subtitles"
                        ItemsSource="{x:Bind Vm.SubtitleChoices, Mode=OneWay}"
                        SelectedItem="{x:Bind Vm.SelectedSubtitle, Mode=TwoWay, Converter={StaticResource ObjectPassthrough}}"
                        Visibility="{x:Bind Vm.HasSubtitleMenu, Mode=OneWay}"
                        ToolTipService.ToolTip="Subtitles" />
                    <ComboBox
                        MinWidth="120"
                        PlaceholderText="Audio"
                        ItemsSource="{x:Bind Vm.AudioChoices, Mode=OneWay}"
                        SelectedItem="{x:Bind Vm.SelectedAudio, Mode=TwoWay, Converter={StaticResource ObjectPassthrough}}"
                        Visibility="{x:Bind Vm.HasAudioMenu, Mode=OneWay}"
                        ToolTipService.ToolTip="Audio track" />
                    <ComboBox
                        MinWidth="100"
                        PlaceholderText="Quality"
                        ItemsSource="{x:Bind Vm.ResolutionChoices, Mode=OneWay}"
                        SelectedItem="{x:Bind Vm.SelectedResolution, Mode=TwoWay, Converter={StaticResource ObjectPassthrough}}"
                        Visibility="{x:Bind Vm.HasResolutionMenu, Mode=OneWay}"
                        ToolTipService.ToolTip="Quality" />
                    <Button x:Name="ExternalButton" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Open in another player">
                        <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="ExternalMenu" Opening="OnExternalMenuOpening" />
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <MediaPlayerElement
            x:Name="Player"
            Grid.Row="1"
            AreTransportControlsEnabled="True"
            AutoPlay="True"
            Stretch="Uniform">
            <MediaPlayerElement.TransportControls>
                <MediaTransportControls
                    IsCompact="False"
                    IsFullWindowButtonVisible="True"
                    IsFullWindowEnabled="True"
                    IsZoomButtonVisible="True"
                    IsZoomEnabled="True"
                    IsSkipBackwardButtonVisible="True"
                    IsSkipBackwardEnabled="True"
                    IsSkipForwardButtonVisible="True"
                    IsSkipForwardEnabled="True"
                    IsPlaybackRateButtonVisible="True"
                    IsPlaybackRateEnabled="True" />
            </MediaPlayerElement.TransportControls>
        </MediaPlayerElement>

        <ProgressRing Grid.Row="1" Width="48" Height="48" IsActive="{x:Bind Vm.IsLoading, Mode=OneWay}" />

        <InfoBar
            Grid.Row="1"
            Margin="24"
            VerticalAlignment="Top"
            IsClosable="True"
            IsOpen="{x:Bind Vm.HasError, Mode=OneWay}"
            Message="{x:Bind Vm.Error, Mode=OneWay}"
            Severity="Error"
            Title="Playback problem" />
    </Grid>
</Window>
